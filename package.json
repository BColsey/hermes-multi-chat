{
  "name": "hermes-dashboard-multi-chat",
  "version": "0.2.2",
  "private": true,
  "description": "Independent real-TUI conversations in the Hermes Web Dashboard.",
  "repository": {
    "type": "git",
    "url": "https://github.com/BColsey/hermes-multi-chat.git"
  },
  "homepage": "https://github.com/BColsey/hermes-multi-chat#readme",
  "bugs": {
    "url": "https://github.com/BColsey/hermes-multi-chat/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts/*.mjs && prettier --check src tests scripts/*.mjs dashboard/manifest.json package.json tsconfig.json playwright.config.ts",
    "format": "prettier --write src tests scripts/*.mjs dashboard/manifest.json package.json tsconfig.json playwright.config.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "package": "npm run build && node scripts/package.mjs",
    "catalog": "npm run build && python3 scripts/catalog.py",
    "catalog:check": "python3 scripts/catalog.py --check",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "check:public": "node scripts/check-public.mjs",
    "sbom": "node scripts/sbom.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fake-indexeddb": "6.2.7",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
